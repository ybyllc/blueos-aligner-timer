<script>
  import router from '@blueos.app.appmanager.router'
  import prompt from '@blueos.window.prompt'
  import exchange from '@blueos.storage.exchange'
  import { STATUS_KEY, readWatchfaceStatus } from '../../../src/watchface-state'

  export default {
    data: { clock: '--:--', dateLabel: '', launching: false, wearLabel: '点此同步',
      wearTime: '--:--:--', wearPercent: 0, ringColor: '#7bc77e', ringTrack: '#35413c' },
    onInit() {
      this.refreshClock()
    },
    onReady() {
      this.startClock()
    },
    onShow() {
      this.startClock()
    },
    onHide() {
      this.stopClock()
    },
    onDestroy() {
      this.stopClock()
    },
    refreshClock() {
      const now = new Date()
      const pad = value => String(value).padStart(2, '0')
      const weekdays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
      this.clock = `${pad(now.getHours())}:${pad(now.getMinutes())}`
      this.dateLabel = `${now.getMonth() + 1}月${now.getDate()}日  ${weekdays[now.getDay()]}`
    },
    startClock() {
      this.stopClock()
      this.active = true
      this.launching = false
      this.tick()
    },
    tick() {
      if (!this.active) return
      this.refreshClock()
      const now = Date.now()
      if (!this.nextRead || now >= this.nextRead) {
        this.nextRead = now + 15000
        this.readWear()
      }
      this.refreshWear()
      this.ticker = setTimeout(() => this.tick(), 1000 - new Date().getMilliseconds() + 20)
    },
    stopClock() {
      this.active = false
      this.nextRead = 0
      this.readGeneration = (this.readGeneration || 0) + 1
      if (this.ticker) clearTimeout(this.ticker)
      this.ticker = null
    },
    readWear() {
      const generation = ++this.readGeneration
      const apply = value => {
        if (!this.active || generation !== this.readGeneration) return
        this.sharedStatus = value
        this.refreshWear()
      }
      try {
        exchange.get({ key: STATUS_KEY, scope: 'vendor',
          success: data => apply(data.value), fail: () => apply(null) })
      } catch (error) { apply(null) }
    },
    refreshWear() {
      const status = readWatchfaceStatus(this.sharedStatus, Date.now())
      this.wearLabel = status ? (status.wearing ? '佩戴中' : '已摘下') : '点此同步'
      this.wearTime = status ? status.time : '--:--:--'
      this.wearPercent = status ? status.percent : 0
      this.ringColor = status && !status.wearing ? '#f05252' : '#7bc77e'
      this.ringTrack = status && !status.wearing ? '#523237' : '#35413c'
    },
    openTimer() {
      if (this.launching) return
      this.launching = true
      try {
        router.push({ uri: 'hap://app/com.personal.alignertimer/pages/Demo' })
      } catch (error) {
        prompt.showToast({ message: '请先安装牙套计时器' })
      }
      this.launching = false
    },
  }
</script>

<template>
  <div class="face">
    <text class="date">{{ dateLabel }}</text>
    <text class="clock">{{ clock }}</text>
    <div class="cat-button" onclick="openTimer">
      <image class="cat" src="/watch300102/assets/cat.png" />
    </div>
    <div class="complication" onclick="openTimer">
      <stack class="wear-dial">
        <progress class="wear-ring" type="arc" percent="{{ wearPercent }}" style="color: {{ ringColor }}; background-color: {{ ringTrack }};" />
        <div class="wear-center">
          <image class="tooth" src="/watch300102/assets/aligner-icon.png" />
        </div>
      </stack>
      <div class="wear-info">
        <text class="wear-label" style="color: {{ ringColor }};">{{ wearLabel }}</text>
        <text class="wear-time">{{ wearTime }}</text>
      </div>
    </div>
  </div>
</template>

<style>
  .face { width: 100%; height: 100%; background-color: #191d24; flex-direction: column; align-items: center; justify-content: center; }
  .date { width: 366px; height: 36px; lines: 1; text-align: center; font-size: 28px; color: #c7bfb2; }
  .clock { width: 410px; height: 104px; lines: 1; text-align: center; font-size: 90px; color: #fff2dc; }
  .cat-button { width: 288px; height: 162px; justify-content: center; align-items: center; }
  .cat { width: 288px; height: 162px; }
  .complication { width: 324px; height: 132px; align-items: center; justify-content: center; }
  .wear-dial { width: 124px; height: 124px; }
  .wear-ring { width: 124px; height: 124px; stroke-width: 8px; start-angle: 270deg; total-angle: 360deg; }
  .wear-center { width: 124px; height: 124px; justify-content: center; align-items: center; background-color: transparent; }
  .tooth { width: 64px; height: 64px; }
  .wear-info { width: 178px; margin-left: 18px; flex-direction: column; justify-content: center; }
  .wear-label { width: 178px; height: 38px; lines: 1; font-size: 28px; }
  .wear-time { width: 178px; height: 46px; lines: 1; font-size: 34px; color: #fff2dc; }
</style>
