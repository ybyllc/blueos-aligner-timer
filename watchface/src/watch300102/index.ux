<script>
  import router from '@blueos.app.appmanager.router'
  import prompt from '@blueos.window.prompt'
  import exchange from '@blueos.storage.exchange'
  import battery from '@blueos.hardware.battery.battery'
  import health from '@blueos.health.health'
  import { STATUS_KEY, readWatchfaceStatus } from '../../../src/watchface-state'

  export default {
    data: { clock: '--:--', dateLabel: '', launching: false, wearLabel: '点此同步',
      wearTime: '--:--:--', wearPercent: 0, ringColor: '#7bc77e', ringTrack: '#193523',
      heartRate: '--', oxygen: '--', oxygenPercent: 0, batteryPercent: 0,
      movePercent: 0, exercisePercent: 0, standPercent: 0 },
    onInit() {
      this.refreshClock()
    },
    onReady() {
      this.startClock()
    },
    onShow() {
      this.startClock()
    },
    onHide() {
      this.stopClock()
    },
    onDestroy() {
      this.stopClock()
    },
    refreshClock() {
      const now = new Date()
      const pad = value => String(value).padStart(2, '0')
      const weekdays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
      this.clock = `${pad(now.getHours())}:${pad(now.getMinutes())}`
      this.dateLabel = `${now.getDate()} ${weekdays[now.getDay()]}`
      const day = `${now.getFullYear()}-${now.getMonth()}-${now.getDate()}`
      if (this.healthDay !== day) {
        this.healthDay = day
        this.nextDeviceRead = 0
        this.movePercent = 0
        this.exercisePercent = 0
        this.standPercent = 0
      }
    },
    startClock() {
      this.stopClock()
      this.active = true
      this.launching = false
      this.tick()
    },
    tick() {
      if (!this.active) return
      this.refreshClock()
      const now = Date.now()
      if (!this.nextRead || now >= this.nextRead) {
        this.nextRead = now + 15000
        this.readWear()
      }
      if (!this.nextDeviceRead || now >= this.nextDeviceRead) {
        this.nextDeviceRead = now + 30000
        this.readDeviceData()
      }
      this.refreshWear()
      this.ticker = setTimeout(() => this.tick(), 1000 - new Date().getMilliseconds() + 20)
    },
    stopClock() {
      this.active = false
      this.nextRead = 0
      this.nextDeviceRead = 0
      this.systemReadGeneration = (this.systemReadGeneration || 0) + 1
      this.readGeneration = (this.readGeneration || 0) + 1
      if (this.ticker) clearTimeout(this.ticker)
      this.ticker = null
    },
    readWear() {
      const generation = ++this.readGeneration
      const apply = value => {
        if (!this.active || generation !== this.readGeneration) return
        this.sharedStatus = value
        this.refreshWear()
      }
      try {
        exchange.get({ key: STATUS_KEY, scope: 'vendor',
          success: data => apply(data.value), fail: () => apply(null) })
      } catch (error) { apply(null) }
    },
    refreshWear() {
      const status = readWatchfaceStatus(this.sharedStatus, Date.now())
      this.wearLabel = status ? (status.wearing ? '佩戴中' : '已摘下') : '点此同步'
      this.wearTime = status ? status.time : '--:--:--'
      this.wearPercent = status ? status.percent : 0
      this.ringColor = status && !status.wearing ? '#f05252' : '#7bc77e'
      this.ringTrack = status && !status.wearing ? '#451e25' : '#193523'
    },
    readDeviceData() {
      const generation = ++this.systemReadGeneration
      const current = () => this.active && generation === this.systemReadGeneration
      try {
        battery.getStatus({ success: result => {
          if (current()) this.batteryPercent = Number.isFinite(result.level) ? Math.max(0, Math.min(100, result.level * 100)) : 0
        }, fail: () => { if (current()) this.batteryPercent = 0 } })
      } catch (error) { this.batteryPercent = 0 }
      const unavailable = () => {
        if (!current()) return
        this.heartRate = '--'
        this.oxygen = '--'
        this.oxygenPercent = 0
      }
      try {
        const types = [health.DATA_TYPES.HEART_RATE, health.DATA_TYPES.SPO2]
        health.getRecentSamples({ dataTypes: types, dataType: types,
          success: result => {
            if (!current()) return
            this.heartRate = '--'
            this.oxygen = '--'
            this.oxygenPercent = 0
            const samples = Array.isArray(result) ? result : [result]
            samples.forEach(sample => {
              const value = sample && sample.data && sample.data.value
              if (!Number.isFinite(value) || value <= 0) return
              if (sample.dataType === health.DATA_TYPES.HEART_RATE) this.heartRate = String(Math.round(value))
              if (sample.dataType === health.DATA_TYPES.SPO2 && value <= 100) {
                this.oxygen = String(Math.round(value))
                this.oxygenPercent = value
              }
            })
          }, fail: unavailable })
      } catch (error) { unavailable() }
      const goals = [
        [health.DATA_TYPES && health.DATA_TYPES.CALORIES, 'movePercent', 500],
        [health.DATA_TYPES && health.DATA_TYPES.INTENSITY_SPORT, 'exercisePercent', 30],
        [health.DATA_TYPES && health.DATA_TYPES.STANDING, 'standPercent', 12],
      ]
      goals.forEach(([dataType, field, goal]) => {
        const clear = () => { if (current()) this[field] = 0 }
        if (dataType === undefined) { clear(); return }
        try {
          health.getTodayStatistic({ dataType, statisticType: health.STATISTIC_TYPES.SUM,
            success: result => {
              if (!current()) return
              const statistic = Array.isArray(result) ? result[0] : result
              const value = statistic && statistic.value
              this[field] = Number.isFinite(value) ? Math.max(0, Math.min(100, value / goal * 100)) : 0
            }, fail: clear })
        } catch (error) { clear() }
      })
    },
    openTimer() {
      if (this.launching) return
      this.launching = true
      try {
        router.push({ uri: 'hap://app/com.personal.alignertimer/pages/Demo' })
      } catch (error) {
        prompt.showToast({ message: '请先安装牙套计时器' })
      }
      this.launching = false
    },
  }
</script>

<template>
  <div class="face">
    <div class="header">
      <stack class="activity-dial">
        <progress class="activity-move" type="arc" percent="{{ movePercent }}" />
        <div class="activity-layer">
          <stack class="activity-exercise-dial">
            <progress class="activity-exercise" type="arc" percent="{{ exercisePercent }}" />
            <div class="activity-exercise-layer">
              <progress class="activity-stand" type="arc" percent="{{ standPercent }}" />
            </div>
          </stack>
        </div>
      </stack>
      <div class="time-column">
        <text class="date">{{ dateLabel }}</text>
        <text class="clock">{{ clock }}</text>
      </div>
    </div>
    <div class="middle">
      <image class="cat" src="/watch300102/assets/cat.png" />
      <div class="mood">
        <text class="mood-title">✦ 状态优秀 ✦</text>
        <div class="heart-row">
          <image class="heart-icon" src="/watch300102/assets/heart.png" />
          <text class="heart-rate">{{ heartRate }} bpm</text>
        </div>
        <image class="mood-bar" src="/watch300102/assets/mood-bar.png" />
      </div>
    </div>
    <div class="footer">
      <stack class="metric-dial">
        <progress class="battery-ring" type="arc" percent="{{ batteryPercent }}" />
        <div class="metric-center">
          <image class="battery-icon" src="/watch300102/assets/battery.png" />
        </div>
      </stack>
      <stack class="metric-dial">
        <progress class="oxygen-ring" type="arc" percent="{{ oxygenPercent }}" />
        <div class="metric-center">
          <text class="oxygen-value">{{ oxygen }}</text>
        </div>
      </stack>
      <stack class="wear-dial" onclick="openTimer">
        <progress class="wear-ring" type="arc" percent="{{ wearPercent }}" style="color: {{ ringColor }}; background-color: {{ ringTrack }};" />
        <div class="wear-center">
          <text class="wear-label" style="color: {{ ringColor }};">{{ wearLabel }}</text>
          <image class="tooth" src="/watch300102/assets/aligner-icon.png" />
          <text class="wear-time">{{ wearTime }}</text>
        </div>
      </stack>
    </div>
  </div>
</template>

<style>
  .face { width: 100%; height: 100%; background-color: #000000; flex-direction: column; align-items: center; padding-top: 24px; }
  .header { width: 358px; height: 154px; align-items: center; }
  .activity-dial { width: 102px; height: 102px; margin-top: 42px; margin-right: 34px; }
  .activity-move { width: 102px; height: 102px; stroke-width: 11px; start-angle: 270deg; total-angle: 360deg; color: #ff2e86; background-color: #35101f; }
  .activity-layer { width: 102px; height: 102px; justify-content: center; align-items: center; background-color: transparent; }
  .activity-exercise-dial { width: 76px; height: 76px; }
  .activity-exercise { width: 76px; height: 76px; stroke-width: 10px; start-angle: 270deg; total-angle: 360deg; color: #b6ff00; background-color: #273400; }
  .activity-exercise-layer { width: 76px; height: 76px; justify-content: center; align-items: center; background-color: transparent; }
  .activity-stand { width: 50px; height: 50px; stroke-width: 10px; start-angle: 270deg; total-angle: 360deg; color: #00e9dd; background-color: #07322f; }
  .time-column { width: 222px; height: 154px; flex-direction: column; }
  .date { width: 222px; height: 42px; lines: 1; text-align: right; font-size: 32px; color: #ff5a52; }
  .clock { width: 230px; height: 112px; lines: 1; text-align: right; font-size: 88px; color: #eeeeee; }
  .middle { width: 346px; height: 118px; margin-top: 22px; align-items: center; }
  .cat { width: 108px; height: 108px; margin-right: 16px; }
  .mood { width: 222px; height: 104px; flex-direction: column; justify-content: center; }
  .mood-title { width: 222px; height: 40px; lines: 1; font-size: 32px; color: #62c7a2; }
  .heart-row { width: 222px; height: 32px; align-items: center; }
  .heart-icon { width: 22px; height: 22px; margin-right: 6px; }
  .heart-rate { width: 194px; height: 32px; lines: 1; font-size: 24px; color: #ffffff; }
  .mood-bar { width: 222px; height: 20px; margin-top: 8px; }
  .footer { width: 370px; height: 112px; margin-top: 16px; justify-content: space-between; align-items: center; }
  .metric-dial { width: 108px; height: 108px; }
  .metric-center { width: 108px; height: 108px; justify-content: center; align-items: center; background-color: transparent; }
  .battery-ring { width: 108px; height: 108px; stroke-width: 10px; start-angle: 270deg; total-angle: 360deg; color: #8d80ff; background-color: #26262c; }
  .battery-icon { width: 50px; height: 60px; }
  .oxygen-ring { width: 108px; height: 108px; stroke-width: 9px; start-angle: 270deg; total-angle: 360deg; color: #2ad959; background-color: #102f18; }
  .oxygen-value { width: 86px; height: 46px; lines: 1; text-align: center; font-size: 36px; color: #ffffff; }
  .wear-dial { width: 108px; height: 108px; }
  .wear-ring { width: 108px; height: 108px; stroke-width: 8px; start-angle: 270deg; total-angle: 360deg; }
  .wear-center { width: 108px; height: 108px; flex-direction: column; justify-content: center; align-items: center; background-color: transparent; }
  .tooth { width: 36px; height: 36px; }
  .wear-label { width: 86px; height: 22px; lines: 1; text-align: center; font-size: 17px; }
  .wear-time { width: 94px; height: 24px; lines: 1; text-align: center; font-size: 19px; color: #ffffff; }
</style>
